{
  "name": "world-money-dashboard",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node src/server/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/auditPrivileges.integration.test.mjs",
    "export:legacy-boundary": "node scripts/export-legacy-boundary.mjs",
    "electron": "electron .",
    "desktop": "npm run build && electron electron-main.cjs",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\""
  },
  "dependencies": {
    "@react-sigma/core": "^5.0.6",
    "d3-force": "^3.0.0",
    "flexlayout-react": "^0.10.6",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "pg": "^8.23.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
